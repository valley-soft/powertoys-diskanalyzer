<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <Version>1.5.0</Version>
    <Authors>ValleySoft</Authors>
    <Company>ValleySoft</Company>
    <Product>DiskAnalyzer</Product>
    <Copyright>Copyright (c) 2026 ValleySoft</Copyright>
    <DefaultItemExcludes>$(DefaultItemExcludes);Standalone App\**;CmdPalExtension\**;Installer\**;WingetManifests\**;Core\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Installer\**" />
    <Content Remove="Installer\**" />
    <EmbeddedResource Remove="Installer\**" />
    <None Remove="Installer\**" />
    
    <Compile Remove="CmdPalExtension\**" />
    <Content Remove="CmdPalExtension\**" />
    <EmbeddedResource Remove="CmdPalExtension\**" />
    <None Remove="CmdPalExtension\**" />
    
    <Compile Remove="CmdPalExtension\**" />
    <Content Remove="CmdPalExtension\**" />
    <EmbeddedResource Remove="CmdPalExtension\**" />
    <None Remove="CmdPalExtension\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile Core directly to avoid ALC load issues in PowerToys Run -->
    <Compile Include="Core\ValleySoft.DiskAnalyzer.Core\**\*.cs" Exclude="Core\ValleySoft.DiskAnalyzer.Core\obj\**;Core\ValleySoft.DiskAnalyzer.Core\bin\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- v1.5.0: Community.PowerToys.Run.Plugin.Dependencies is currently v0.97.0.
         Monitor https://www.nuget.org/packages/Community.PowerToys.Run.Plugin.Dependencies
         for v0.98.0+ and upgrade the PackageReference in the .csproj when available. -->
    <PackageReference Include="Community.PowerToys.Run.Plugin.Dependencies" Version="0.97.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Removed ProjectReference to compile directly -->
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Themes\Light.xaml" />
    <Resource Include="Themes\Dark.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="plugin.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="Images\*.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>

 

