<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ValleySoft_DiskAnalyzer_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ValleySoft_DiskAnalyzer_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#CBD5E1" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="#1E293B" />
                    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#334155" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="#1E293B" />
                    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#334155" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
