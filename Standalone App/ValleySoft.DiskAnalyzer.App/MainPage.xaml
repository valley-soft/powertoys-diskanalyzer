<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ValleySoft_DiskAnalyzer_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ValleySoft_DiskAnalyzer_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#94A3B8" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#334155" />
                    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#CBD5E1" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#334155" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <MenuBar Grid.Row="0" Margin="-12,-12,-12,12">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Select Directory..." Icon="Folder" Click="BrowseButton_Click"/>
                <MenuFlyoutItem Text="Export to CSV..." Icon="Save" Click="ExportToCsv_Click"/>
                <MenuFlyoutSeparator/>
                <ToggleMenuFlyoutItem Text="Always Run as Administrator" Click="RunAsAdmin_Click" x:Name="RunAsAdminToggle"/>
                <ToggleMenuFlyoutItem Text="Show warning when running as user" Click="ShowAdminWarning_Click" x:Name="ShowAdminWarningToggle" IsChecked="True"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Exit" Icon="Cancel" Click="ExitMenu_Click"/>
            </MenuBarItem>
            <MenuBarItem Title="Scan">
                <MenuFlyoutItem Text="Refresh Current" Icon="Refresh" Click="RefreshButton_Click"/>
            </MenuBarItem>
            <MenuBarItem Title="View">
                <ToggleMenuFlyoutItem Text="Show Hidden Files" IsChecked="True" Click="ShowHiddenFiles_Click" x:Name="ShowHiddenFilesToggle"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Expand Root Folders" Icon="Add" Click="ExpandAll_Click"/>
                <MenuFlyoutItem Text="Collapse All" Icon="Remove" Click="CollapseAll_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutSubItem Text="Theme">
                    <MenuFlyoutItem Text="System" Tag="Default" Click="ThemeMenuItem_Click"/>
                    <MenuFlyoutItem Text="Light" Tag="Light" Click="ThemeMenuItem_Click"/>
                    <MenuFlyoutItem Text="Dark" Tag="Dark" Click="ThemeMenuItem_Click"/>
                </MenuFlyoutSubItem>
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="View Help" Icon="Library" Click="ViewHelp_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="About Disk Analyzer" Click="About_Click"/>
            </MenuBarItem>
        </MenuBar>

        <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,12">
            <InfoBar x:Name="AdminWarningBar" Severity="Warning" Title="Running as user" Message="Administrator privileges are required to properly scan protected system directories, other user profiles, and hidden system files for an accurate representation of hard drive usage." IsOpen="False" CornerRadius="8">
                <InfoBar.ActionButton>
                    <Button Content="Restart as Administrator" Click="RestartAsAdminInfoBar_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            
            <InfoBar x:Name="InsiderWarningBar" Severity="Informational" Title="Windows Insider Build Detected" Message="You are running a Windows Insider Preview build. Pre-release Windows versions can introduce graphics, API, and Desktop Window Manager (DWM) updates that may cause window initialization, rendering, or composition conflicts." IsOpen="False" CornerRadius="8"/>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                
                <Grid Grid.Column="0" Tapped="BreadcrumbContainer_Tapped" Background="Transparent" VerticalAlignment="Center">
                    <BreadcrumbBar x:Name="PathBreadcrumbBar" ItemClicked="PathBreadcrumbBar_ItemClicked">
                        <BreadcrumbBar.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="16" FontWeight="SemiBold" />
                            </DataTemplate>
                        </BreadcrumbBar.ItemTemplate>
                    </BreadcrumbBar>
                    <TextBox x:Name="EditablePathBox" Visibility="Collapsed" KeyDown="EditablePathBox_KeyDown" LostFocus="EditablePathBox_LostFocus" PlaceholderText="Enter path..." />
                </Grid>

                <Button Grid.Column="1" x:Name="BackButton" AutomationProperties.Name="Back" Click="BackButton_Click" IsEnabled="False" Height="40" Padding="16,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock Text="Back" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" x:Name="ExportCsvButton" Click="ExportToCsv_Click" IsEnabled="False" Height="40" Padding="16,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE780;" FontSize="14" />
                        <TextBlock Text="Export CSV" />
                    </StackPanel>
                </Button>

                <TextBox x:Name="FilterBox" Grid.Column="3" PlaceholderText="Filter (e.g. *.mp4)" VerticalAlignment="Center" Margin="12,0,0,0" TextChanged="FilterBox_TextChanged" />
            </Grid>
        </StackPanel>
        
        <ProgressBar x:Name="ScanProgressBar" Grid.Row="2" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,-4,0,0" Canvas.ZIndex="10"/>

        <!-- Main Content area with TreeView, DataGrid, and Breakdown Panel -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="250" MinWidth="150" />
            </Grid.ColumnDefinitions>

            <!-- Left pane: TreeView -->
            <Grid Grid.Column="0" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TreeView x:Name="FolderTree" 
                          Expanding="FolderTree_Expanding" 
                          ItemInvoked="FolderTree_ItemInvoked">
                    <!-- Data templates for TreeView will be configured in code behind or here -->
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="local:FolderNode">
                            <TreeViewItem ItemsSource="{x:Bind Children}" HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="{x:Bind IconSource}" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <!-- GridSplitter -->
            <controls:GridSplitter Grid.Column="1" Width="12" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <!-- Right pane: DataGrid -->
            <Grid Grid.Column="2" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Pivot Grid.Row="0">
                    <PivotItem Header="Details">
                        <controls:DataGrid x:Name="ResultsGrid" 
                            AutoGenerateColumns="False" 
                            IsReadOnly="True" 
                            GridLinesVisibility="Horizontal" 
                            HeadersVisibility="Column" 
                            DoubleTapped="ResultsGrid_DoubleTapped"
                            AlternatingRowBackground="{ThemeResource ControlFillColorTransparentBrush}"
                            RowBackground="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderThickness="0"
                            CanUserResizeColumns="True"
                            CanUserSortColumns="True"
                            ManipulationMode="TranslateY,TranslateRailsY,TranslateInertia"
                            PointerWheelChanged="ResultsGrid_PointerWheelChanged"
                            ManipulationDelta="ResultsGrid_ManipulationDelta"
                            Sorting="ResultsGrid_Sorting">
                            <controls:DataGrid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Open in Explorer" Click="DataGrid_OpenInExplorer_Click" />
                                    <MenuFlyoutItem Text="Copy Path" Click="DataGrid_CopyPath_Click" />
                                </MenuFlyout>
                            </controls:DataGrid.ContextFlyout>
                            <controls:DataGrid.Columns>
                                <controls:DataGridTemplateColumn Header="Name" Tag="Name" Width="*" MinWidth="350">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="12,0,0,0">
                                                <Image Source="{Binding IconSource}" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                                <controls:DataGridTemplateColumn Header="% of Parent" Tag="Percentage" Width="105" SortDirection="Descending">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center" Spacing="6">
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ParentPercentage}" Height="14" Width="40" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Background="{ThemeResource ControlFillColorTransparentBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"/>
                                                <TextBlock Text="{Binding FormattedPercentage}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                                <controls:DataGridTextColumn Header="Size" Tag="Size" Binding="{Binding FormattedSize}" Width="100"/>
                                <controls:DataGridTextColumn Header="Allocated" Tag="Allocated" Binding="{Binding FormattedAllocated}" Width="100"/>
                                <controls:DataGridTextColumn Header="Free Space" Tag="FreeSpace" Binding="{Binding FormattedFreeSpace}" Width="90"/>
                                <controls:DataGridTextColumn Header="Files" Tag="Files" Binding="{Binding FileCount}" Width="70"/>
                                <controls:DataGridTextColumn Header="Folders" Tag="Folders" Binding="{Binding FolderCount}" Width="70"/>
                                <controls:DataGridTextColumn Header="Modified" Tag="Modified" Binding="{Binding FormattedDate}" Width="140"/>
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                    </PivotItem>
                    <PivotItem Header="Visual Chart">
                        <Grid Padding="24">
                            <ItemsControl x:Name="ChartItemsControl" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:ChartItemViewModel">
                                        <StackPanel VerticalAlignment="Bottom" ToolTipService.ToolTip="{x:Bind ToolTip}" Tapped="ChartItem_Tapped" Background="Transparent">
                                            <Rectangle Width="80" Height="{x:Bind Height}" Fill="{x:Bind Color}" StrokeThickness="1" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" RadiusX="4" RadiusY="4"/>
                                            <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Width="80" FontSize="12" Margin="0,8,0,0" TextAlignment="Center" />
                                            <TextBlock Text="{x:Bind FormattedSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" FontSize="11" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </PivotItem>
                </Pivot>

                <!-- Status bar: item count -->
                <Border Grid.Row="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="0,0,8,8"
                        Padding="12,5,12,5">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock x:Name="ItemCountText"
                                   Text="0 items"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Rectangle Width="1" Height="12"
                                   Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- GridSplitter 2 -->
            <controls:GridSplitter Grid.Column="3" Width="12" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <!-- File Type Breakdown Pane -->
            <Grid Grid.Column="4" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="File Type Breakdown" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                
                <ListView Grid.Row="1" x:Name="TypeBreakdownList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TypeCategoryViewModel">
                            <Grid Padding="0,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Column="0" Grid.Row="0" Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="{x:Bind FormattedSize}" HorizontalAlignment="Right"/>
                                
                                <ProgressBar Grid.ColumnSpan="2" Grid.Row="1" Value="{x:Bind Percentage}" Maximum="100" Height="6" CornerRadius="3" Margin="0,6,0,2" Background="{ThemeResource ControlFillColorSecondaryBrush}" Foreground="{x:Bind ColorBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
